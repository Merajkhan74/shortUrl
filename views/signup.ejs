<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Sign Up | URL Shortener</title>

    <meta
        name="description"
        content="Create your URL Shortener account."
    >

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;

            min-height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            background: linear-gradient(
                135deg,
                #eef2ff,
                #f8fafc,
                #ede9fe
            );

            color: #172033;
        }

        /* Main Container */

        .signup-container {
            width: 100%;
            max-width: 450px;
            padding: 20px;
        }

        /* Card */

        .signup-card {
            background: #ffffff;

            padding: 40px;

            border-radius: 20px;

            box-shadow:
                0 20px 50px rgba(0, 0, 0, 0.10);
        }

        /* Logo */

        .logo {
            text-align: center;

            font-size: 27px;
            font-weight: 700;

            margin-bottom: 10px;
        }

        .logo span {
            color: #4f46e5;
        }

        /* Heading */

        h1 {
            text-align: center;

            font-size: 30px;

            margin-bottom: 10px;
        }

        .subtitle {
            text-align: center;

            color: #6b7280;

            font-size: 14px;

            margin-bottom: 30px;
        }

        /* Form */

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;

            font-size: 14px;

            font-weight: 600;

            margin-bottom: 8px;
        }

        /* Input */

        input {
            width: 100%;

            padding: 14px 15px;

            border: 1px solid #d1d5db;

            border-radius: 10px;

            font-size: 15px;

            outline: none;

            transition: 0.2s;
        }

        input:focus {
            border-color: #6366f1;

            box-shadow:
                0 0 0 3px rgba(99, 102, 241, 0.12);
        }

        input::placeholder {
            color: #9ca3af;
        }

        /* Button */

        .signup-btn {
            width: 100%;

            padding: 14px;

            border: none;

            border-radius: 10px;

            background: linear-gradient(
                135deg,
                #4f46e5,
                #7c3aed
            );

            color: white;

            font-size: 16px;

            font-weight: 600;

            cursor: pointer;

            transition: 0.2s;
        }

        .signup-btn:hover {
            transform: translateY(-2px);

            box-shadow:
                0 8px 20px rgba(79, 70, 229, 0.30);
        }

        /* Login Link */

        .login-text {
            text-align: center;

            margin-top: 25px;

            color: #6b7280;

            font-size: 14px;
        }

        .login-text a {
            color: #4f46e5;

            font-weight: 600;

            text-decoration: none;
        }

        .login-text a:hover {
            text-decoration: underline;
        }

        /* Home */

        .home-link {
            display: block;

            text-align: center;

            margin-top: 18px;

            color: #6b7280;

            font-size: 14px;

            text-decoration: none;
        }

        .home-link:hover {
            color: #4f46e5;
        }

        /* Mobile */

        @media (max-width: 500px) {

            .signup-container {
                padding: 15px;
            }

            .signup-card {
                padding: 30px 22px;
            }

            h1 {
                font-size: 26px;
            }

        }

    </style>

</head>


<body>

    <div class="signup-container">

        <div class="signup-card">

            <!-- Logo -->

            <div class="logo">
                🔗 URL <span>Shortener</span>
            </div>


            <!-- Heading -->

            <h1>
                Create Account 
            </h1>

            <p class="subtitle">
                Sign up to manage your short URLs
            </p>


            <!-- Signup Form -->

            <form
                action="/user"
                method="POST"
            >

                <!-- Full Name -->

                <div class="form-group">

                    <label for="name">
                        Full Name
                    </label>

                    <input
                        type="text"
                        required
                        name="name"
                        id="name"
                        placeholder="Enter your full name"
                        autocomplete="name"
                    >

                </div>


                <!-- Email -->

                <div class="form-group">

                    <label for="email">
                        Email
                    </label>

                    <input
                        type="email"
                        required
                        name="email"
                        id="email"
                        placeholder="Enter your email"
                        autocomplete="email"
                    >

                </div>


                <!-- Password -->

                <div class="form-group">

                    <label for="password">
                        Password
                    </label>

                    <input
                        type="password"
                        required
                        name="password"
                        id="password"
                        placeholder="Create a password"
                        autocomplete="new-password"
                    >

                </div>


                <!-- Submit -->

                <button
                    type="submit"
                    class="signup-btn"
                >
                    Create Account
                </button>

            </form>


            <!-- Login -->

            <p class="login-text">

                Already have an account?

                <a href="/login">
                    Login
                </a>

            </p>


            <!-- Home -->

            <!-- <a
                href="/"
                class="home-link"
            >
                ← Back to Home
            </a> -->

        </div>

    </div>

</body>

</html>