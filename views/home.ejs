

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>URL Short Meraj Khan - Free URL Shortener</title>

    <meta
        name="description"
        content="URL Short Meraj Khan - Create and manage short URLs easily."
    >

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f5f7fb;
            color: #172033;
            min-height: 100vh;
        }

        /* Navbar */

        nav {
            width: 100%;
            background: #111827;
            color: white;
            padding: 18px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 24px;
            font-weight: 700;
        }

        .logo span {
            color: #6366f1;
        }

        nav a {
            color: #d1d5db;
            text-decoration: none;
            margin-left: 25px;
            font-size: 15px;
        }

        nav a:hover {
            color: white;
        }


        /* Hero */

        .hero {
            text-align: center;
            padding: 70px 20px 40px;
        }

        .hero h1 {
            font-size: 48px;
            line-height: 1.15;
            margin-bottom: 18px;
        }

        .hero h1 span {
            color: #4f46e5;
        }

        .hero p {
            color: #6b7280;
            font-size: 18px;
            max-width: 650px;
            margin: auto;
            line-height: 1.6;
        }


        /* Main container */

        .container {
            max-width: 1100px;
            margin: auto;
            padding: 0 20px 70px;
        }


        /* Card */

        .card {
            background: white;
            border-radius: 18px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 10px 35px rgba(0, 0, 0, 0.07);
        }

        .card h2 {
            margin-bottom: 8px;
            font-size: 24px;
        }

        .card-subtitle {
            color: #6b7280;
            margin-bottom: 22px;
        }


        /* Form */

        .url-form {
            display: flex;
            gap: 12px;
        }

        .url-input {
            flex: 1;
            padding: 16px 18px;
            border: 1px solid #d1d5db;
            border-radius: 10px;
            font-size: 16px;
            outline: none;
            transition: 0.2s;
        }

        .url-input:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.12);
        }

        .generate-btn {
            padding: 0 28px;
            border: none;
            border-radius: 10px;
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            color: white;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
        }

        .generate-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(79, 70, 229, 0.3);
        }


        /* Generated URL */

        .generated {
            margin-top: 20px;
            padding: 18px;
            border-radius: 12px;
            background: #eef2ff;
            border: 1px solid #c7d2fe;
        }

        .generated-title {
            font-weight: 600;
            margin-bottom: 8px;
        }

        .generated a {
            color: #4f46e5;
            font-weight: 600;
            text-decoration: none;
            word-break: break-all;
        }

        .generated a:hover {
            text-decoration: underline;
        }


        /* Table header */

        .table-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .link-count {
            background: #eef2ff;
            color: #4f46e5;
            padding: 7px 14px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
        }


        /* Table */

        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 700px;
        }

        thead {
            background: #f8fafc;
        }

        th {
            text-align: left;
            padding: 15px;
            color: #475569;
            font-size: 14px;
            border-bottom: 1px solid #e5e7eb;
        }

        td {
            padding: 16px 15px;
            border-bottom: 1px solid #eef0f4;
            color: #475569;
            font-size: 14px;
        }

        tbody tr:hover {
            background: #fafbff;
        }


        /* Short ID */

        .short-id {
            color: #4f46e5;
            font-weight: 600;
            text-decoration: none;
            background: #eef2ff;
            padding: 7px 10px;
            border-radius: 7px;
            display: inline-block;
        }

        .short-id:hover {
            background: #e0e7ff;
        }


        /* Redirect URL */

        .redirect-url {
            max-width: 350px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .redirect-url a {
            color: #475569;
            text-decoration: none;
        }

        .redirect-url a:hover {
            color: #4f46e5;
            text-decoration: underline;
        }


        /* Clicks */

        .clicks {
            font-weight: 700;
            color: #111827;
        }


        /* Empty state */

        .empty {
            text-align: center;
            padding: 45px 20px;
            color: #6b7280;
        }


        /* Features */

        .features {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .feature {
            background: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.05);
        }

        .feature-icon {
            font-size: 28px;
            margin-bottom: 12px;
        }

        .feature h3 {
            margin-bottom: 8px;
        }

        .feature p {
            color: #6b7280;
            font-size: 14px;
            line-height: 1.5;
        }


        /* Footer */

        footer {
            background: #111827;
            color: #9ca3af;
            text-align: center;
            padding: 28px 20px;
        }

        footer strong {
            color: white;
        }


        /* Responsive */

        @media (max-width: 768px) {

            nav {
                padding: 16px 5%;
            }

            nav .nav-links {
                display: none;
            }

            .hero {
                padding-top: 50px;
            }

            .hero h1 {
                font-size: 36px;
            }

            .hero p {
                font-size: 16px;
            }

            .url-form {
                flex-direction: column;
            }

            .generate-btn {
                height: 52px;
            }

            .features {
                grid-template-columns: 1fr;
            }

            .card {
                padding: 20px;
            }
            .logout-btn {
                background: #ef4444;
                color: white !important;
                padding: 9px 16px;
                border-radius: 8px;
                margin-left: 20px;
            }

            .logout-btn:hover {
                background: #dc2626;
            }
        }
    </style>
</head>


<body>

    <!-- Navbar -->

    <nav>

        <div class="logo">
            🔗 URL <span>Shortener</span>
        </div>

        <div class="nav-links">
            <a href="/">Home</a>
            <a href="#links">My Links</a>
            <a href="/logout" class="logout-btn">Logout</a>
        </div>

    </nav>


    <!-- Hero -->

    <section class="hero">

        <h1>
            Make Your URLs
            <span>Short & Simple</span>
        </h1>

        <p>
            Turn long URLs into short, easy-to-share links.
            Create links instantly and track your clicks.
        </p>

    </section>


    <main class="container">


        <!-- URL Generator -->

        <div class="card">

            <h2>🔗 Create Short URL</h2>

            <p class="card-subtitle">
                Enter your long URL and generate a short link.
            </p>


            <form
                class="url-form"
                method="POST"
                action="/url"
            >

                <input
                    class="url-input"
                    type="url"
                    name="url"
                    placeholder="https://example.com/your-long-url"
                    required
                >

                <button
                    class="generate-btn"
                    type="submit"
                >
                    Generate URL →
                </button>

            </form>


            <% if (locals.id) { %>

                <div class="generated">

                    <div class="generated-title">
                        ✅ URL Generated Successfully
                    </div>

                    <a
                        href="http://localhost:4001/<%= id %>"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        http://localhost:4001/<%= id %>
                    </a>

                </div>

            <% } %>

        </div>


        <!-- Features -->

        <div class="features">

            <div class="feature">

                <div class="feature-icon">
                    ⚡
                </div>

                <h3>Super Fast</h3>

                <p>
                    Generate short URLs quickly and easily.
                </p>

            </div>


            <div class="feature">

                <div class="feature-icon">
                    📊
                </div>

                <h3>Track Clicks</h3>

                <p>
                    Keep track of how many times your links are visited.
                </p>

            </div>


            <div class="feature">

                <div class="feature-icon">
                    🔒
                </div>

                <h3>Simple & Reliable</h3>

                <p>
                    A clean and simple URL shortening experience.
                </p>

            </div>

        </div>


        <!-- URL Table -->

        <div
            class="card"
            id="links"
        >

            <div class="table-header">

                <div>

                    <h2>
                        📋 Your Short URLs
                    </h2>

                    <p class="card-subtitle">
                        Recently created links
                    </p>

                </div>

                <div class="link-count">
                    <%= urls.length %> Links
                </div>

            </div>


            <% if (urls && urls.length > 0) { %>

                <div class="table-wrapper">

                    <table>

                        <thead>

                            <tr>

                                <th>S.No</th>

                                <th>Short ID</th>

                                <th>Redirect URL</th>

                                <th>Clicks</th>

                            </tr>

                        </thead>


                        <tbody>

                            <% urls.forEach((url, index) => { %>

                                <tr>

                                    <td>
                                        <%= index + 1 %>
                                    </td>


                                    <td>

                                        <a
                                            class="short-id"
                                            href="/<%= url.ShortId %>"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            <%= url.ShortId %>
                                        </a>

                                    </td>


                                    <td class="redirect-url">

                                        <a
                                            href="<%= url.redirectUrl %>"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            title="<%= url.redirectUrl %>"
                                        >
                                            <%= url.redirectUrl %>
                                        </a>

                                    </td>


                                    <td class="clicks">

                                        <%= url.visitHistory.length %>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } else { %>

                <div class="empty">

                    <h3>No Short URLs Yet 🔗</h3>

                    <p>
                        Create your first short URL using the form above.
                    </p>

                </div>

            <% } %>

        </div>

    </main>


    <!-- Footer -->

    <footer>

        <p>
            Built with ❤️ using
            <strong>Node.js</strong>,
            <strong>Express</strong> &
            <strong>MongoDB</strong>
        </p>

    </footer>

</body>

</html>